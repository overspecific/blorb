{
  "default_agent": "main",
  "providers": [
    {
      "name": "local",
      "type": "openai-compatible",
      "base_url": "http://localhost:1"
    },
    {
      "name": "remote",
      "type": "openai-compatible",
      "base_url": "https://api.example.com/v1"
    }
  ],
  "models": [
    {
      "name": "m2",
      "provider": "local",
      "model_name": "m2"
    },
    {
      "name": "gpt-4o-mini",
      "provider": "remote",
      "model_name": "gpt-4o-mini"
    }
  ],
  "agents": [
    {
      "name": "main",
      "system_prompt": "You are helpful.",
      "max_turns": 3,
      "tools": [
        "echo",
        "files"
      ],
      "model": "m2"
    },
    {
      "name": "quiet",
      "system_prompt": "You are helpful.",
      "max_turns": 1,
      "tools": [],
      "model": "gpt-4o-mini"
    }
  ],
  "tools": [
    {
      "type": "command",
      "name": "echo",
      "description": "Return a greeting.",
      "command": [
        "echo",
        "hello"
      ],
      "args_schema": {
        "type": "object"
      }
    }
  ],
  "toolsets": [
    {
      "name": "files",
      "type": "builtin",
      "builtin": "file",
      "config": {
        "base_dir": "."
      }
    }
  ]
}
