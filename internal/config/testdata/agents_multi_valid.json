{
  "default_agent": "main",
  "agents": [
    {
      "name": "main",
      "system_prompt": "You are helpful.",
      "provider": {
        "type": "openai",
        "model": "gpt-4o-mini",
        "base_url": "https://api.example.com/v1"
      },
      "max_turns": 3,
      "tools": [
        "echo",
        "read_fixture"
      ]
    },
    {
      "name": "quiet",
      "system_prompt": "You are helpful.",
      "provider": {
        "type": "openai",
        "model": "gpt-4o-mini",
        "base_url": "https://api.example.com/v1"
      },
      "tools": [],
      "max_turns": 1
    }
  ],
  "tools": [
    {
      "type": "command",
      "name": "echo",
      "description": "A command tool.",
      "command": [
        "echo"
      ]
    },
    {
      "type": "builtin",
      "name": "read_fixture",
      "description": "Read a fixture file.",
      "builtin": "read",
      "config": {
        "base_dir": "."
      }
    }
  ]
}
