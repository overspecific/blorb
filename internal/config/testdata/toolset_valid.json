{
  "providers": [
    {
      "name": "local",
      "type": "openai-compatible",
      "base_url": "http://localhost:1"
    }
  ],
  "models": [
    {
      "name": "m",
      "provider": "local",
      "model_name": "m"
    }
  ],
  "agents": [
    {
      "name": "helper",
      "system_prompt": "You are helpful.",
      "model": "m",
      "max_turns": 1
    }
  ],
  "toolsets": [
    {
      "name": "kb",
      "tools": [
        {
          "type": "command",
          "name": "echo",
          "description": "Return a greeting.",
          "command": ["echo", "hello"]
        },
        {
          "type": "builtin",
          "name": "read",
          "description": "Read a file.",
          "builtin": "read",
          "config": {"base_dir": "."}
        }
      ]
    },
    {
      "name": "dev",
      "tools": [
        {"type": "toolset", "toolset": "kb"}
      ]
    }
  ]
}
