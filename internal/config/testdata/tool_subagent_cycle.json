{
  "default_agent": "a",
  "models": [
    {
      "name": "m",
      "type": "openai-compatible",
      "base_url": "http://localhost:1",
      "model_name": "m"
    }
  ],
  "agents": [
    {
      "name": "a",
      "system_prompt": "Agent a.",
      "max_turns": 3,
      "tools": [
        "ask_b"
      ],
      "model": "m"
    },
    {
      "name": "b",
      "system_prompt": "Agent b.",
      "max_turns": 3,
      "tools": [
        "ask_a"
      ],
      "model": "m"
    }
  ],
  "tools": [
    {
      "type": "subagent",
      "name": "ask_a",
      "description": "Ask a.",
      "agent": "a"
    },
    {
      "type": "subagent",
      "name": "ask_b",
      "description": "Ask b.",
      "agent": "b"
    }
  ]
}
