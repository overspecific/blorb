#!/bin/sh
# qc is the quality gate for coding agents to run during development. It
# formats, checks style, and runs the tests; it must pass before moving on.
# All output is captured and shown only if a stage fails.
set -e
set -o pipefail

if [ -d "$HOME/.local/share/mise/shims" ]; then
	export PATH="$HOME/.local/share/mise/shims:$PATH"
fi

run() {
	name="$1"
	shift
	if ! out=$("$@" 2>&1); then
		printf '==> FAILED: %s\n%s\n' "$name" "$out"
		exit 1
	fi
}

fmt() {
	gofmt -w .
	rumdl fmt --silent .
}

mod() {
	go mod tidy -diff
}

lint() {
	staticcheck ./...
}

vet() {
	go vet ./...
}

markdown() {
	rumdl check .
	lychee --offline --no-progress .
}

build() {
	go build ./...
}

test_stats() {
	printf 'coverage:\n'
	go tool cover -func=coverage.out | awk '
		/^total:/ { next }
		{
			split($1, pos, ":")
			file = pos[1]
			sub(/\/[^/]+\.go$/, "", file)
			pct = $NF
			sub(/%$/, "", pct)
			sum[file] += pct
			n[file]++
		}
		END {
			for (pkg in sum) {
				printf "%6.1f%%  %s\n", sum[pkg] / n[pkg], pkg
			}
		}
	' | sort -k2
	go tool cover -func=coverage.out | tail -n 1 | awk '{ pct = $NF; sub(/%$/, "", pct); printf "%6.1f%%  total\n", pct }'
	rm -f coverage.out
}

test() {
	go test -race -count=1 -shuffle=on -coverpkg=./... -coverprofile=coverage.out ./... | sed 's/coverage: [0-9.]*% of statements in \.\/\.\.\.//'
}

run "gofmt -w ." fmt
run "go mod tidy -diff" mod
run "staticcheck ./..." lint
run "go vet ./..." vet
run "markdown checks" markdown
run "go build ./..." build
run "go test ./..." test
test_stats
printf '\nqc passed\n'